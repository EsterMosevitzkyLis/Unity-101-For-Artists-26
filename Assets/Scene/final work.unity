      m_Calls: []
  m_text: "\n You sit aboard a quiet train  \n    as it glides through the\n countryside.
    Outside, golden \n     fields stretch beneath\n   distant  mountains,  and \n     
    scattered homes rest \npeacefully in the landscape. \n A strange nostalgia washes
    \n    over you, sending a chill \n     down your spine-like a\n  memory just
    out of reach.\n\n\n\n"
