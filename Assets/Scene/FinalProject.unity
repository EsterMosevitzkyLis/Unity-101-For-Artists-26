  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: This assignment was originally inspired by the city in the United Kingdom
    where my friend lives. I used photos of a mosaic I found along a walking trail
    in town, and the model of the window frame is a recreation of one from the local
    church.                 But the view from the window is mostly made up of photos
    of the Volkhov River that I took during my trip to Russia, as well as Miracle
    Yudo Fish-Whale, a creature from Eastern folklore based on a fairy tale by Pyotr
    Yershov. Enjoy the view.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fef999da6b36a154d93bcf82544354e2, type: 2}
