  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'A quiet train moves slowly through a misty mountain valley, wrapped in
    rain, wind, and cold. Outside, everything feels distant and grey, the kind of
    weather that makes the world seem paused. But inside the cabin, there is warmth:
    a soft golden light, the presence of a book, and a cup of hot tea held between
    your hands. The animation explores this contrast between harsh, restless nature
    and the small, human space of comfort. It draws inspiration from long journeys,
    solitary travel, and the simple rituals that make unfamiliar places feel safe.
    The mood is nostalgic and intimate, like remembering a moment that never quite
    existed, yet feels deeply familiar'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3b84db32dfdb79140a9625586f61b844, type: 2}
