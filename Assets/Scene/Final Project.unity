  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "You are a passenger on a deep sea submarines expedition. I always loved
    general nautical themes and I feel I do my best work in 3D, and I learned substance
    painter this year and i love it so this seemed like a good direction to go. \r\nI
    basically tried to capture the eerie and ominous vibe that the deep ocean brings
    along with it's enchanting and hypnotic sort of feel that I got when I scuba
    dived in Eilat. I liked the old rustic look of a submarine that looks worn through
    it\u2019s expeditions. The lights may flicker cuz it\u2019s an old submarine.
    I added fairy lights to make it more cozy. Did you find the diver helmet?\r\n"
